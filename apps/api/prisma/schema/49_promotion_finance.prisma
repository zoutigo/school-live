model FeeSchedule {
  id              String           @id @default(cuid())
  schoolId        String
  schoolYearId    String
  academicLevelId String
  trackId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear      SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  academicLevel   AcademicLevel    @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  track           Track?           @relation(fields: [trackId], references: [id], onDelete: Cascade)
  installments    FeeInstallment[]

  // Pas d'unicite DB sur (schoolYearId, academicLevelId, trackId) : Postgres ne
  // traite pas les NULL comme egaux, donc plusieurs niveaux sans filiere pourraient
  // passer un @@unique classique. L'unicite est verifiee cote service (FinanceService).
  @@index([schoolId])
  @@index([schoolYearId])
  @@index([academicLevelId])
  @@index([trackId])
}

model FeeInstallment {
  id            String      @id @default(cuid())
  schoolId      String
  feeScheduleId String
  rank          Int
  label         String
  amount        Float
  dueDate       DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeSchedule   FeeSchedule @relation(fields: [feeScheduleId], references: [id], onDelete: Cascade)

  @@unique([feeScheduleId, rank])
  @@index([schoolId])
  @@index([feeScheduleId])
}

model ReinscriptionDeadline {
  id              String        @id @default(cuid())
  schoolId        String
  schoolYearId    String
  academicLevelId String
  deadline        DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear      SchoolYear    @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)

  @@unique([schoolYearId, academicLevelId])
  @@index([schoolId])
  @@index([academicLevelId])
}

model SupplyList {
  id              String       @id @default(cuid())
  schoolId        String
  schoolYearId    String
  academicLevelId String
  trackId         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear      SchoolYear   @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id], onDelete: Cascade)
  track           Track?       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  items           SupplyItem[]

  // Meme choix que FeeSchedule : pas d'unicite DB sur (schoolYearId,
  // academicLevelId, trackId), Postgres ne traite pas les NULL comme egaux.
  // Unicite verifiee cote service (SupplyListsService).
  @@index([schoolId])
  @@index([schoolYearId])
  @@index([academicLevelId])
  @@index([trackId])
}

model SupplyItem {
  id           String     @id @default(cuid())
  schoolId     String
  supplyListId String
  rank         Int
  label        String
  quantity     Int        @default(1)
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  supplyList   SupplyList @relation(fields: [supplyListId], references: [id], onDelete: Cascade)

  @@unique([supplyListId, rank])
  @@index([schoolId])
  @@index([supplyListId])
}

// Marque la consultation, par un parent, de la liste de fournitures d'un
// enfant pour une annee scolaire donnee. Sert uniquement au badge "non lu"
// affiche dans le menu eleve (meme principe que InternalMessageRecipient.readAt).
model SupplyListView {
  id           String     @id @default(cuid())
  schoolId     String
  parentUserId String
  studentId    String
  schoolYearId String
  seenAt       DateTime   @default(now())
  school       School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentUser   User       @relation("SupplyListViewParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId, schoolYearId])
  @@index([schoolId])
  @@index([studentId, schoolYearId])
}

model Wallet {
  id           String              @id @default(cuid())
  schoolId     String
  parentUserId String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  parentUser   User                @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@unique([schoolId, parentUserId])
  @@index([schoolId])
}

model WalletTransaction {
  id               String                 @id @default(cuid())
  schoolId         String
  walletId         String
  type             WalletTransactionType
  amount           Float
  studentId        String?
  recordedByUserId String
  note             String?
  createdAt        DateTime               @default(now())
  school           School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  wallet           Wallet                 @relation(fields: [walletId], references: [id], onDelete: Cascade)
  student          Student?               @relation(fields: [studentId], references: [id], onDelete: SetNull)
  recordedByUser   User                   @relation("WalletTransactionRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Cascade)
  studentPayment   StudentPayment?

  @@index([schoolId])
  @@index([walletId])
  @@index([studentId])
}

model StudentPayment {
  id                  String               @id @default(cuid())
  schoolId            String
  schoolYearId        String
  studentId           String
  amount              Float
  source              StudentPaymentSource
  walletTransactionId String?              @unique
  recordedByUserId    String
  paidAt              DateTime
  note                String?
  createdAt           DateTime             @default(now())
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear          SchoolYear           @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  walletTransaction   WalletTransaction?   @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  recordedByUser      User                 @relation("StudentPaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolYearId])
  @@index([studentId, schoolYearId])
}

/// Admission d'un nouvel eleve (premiere arrivee dans l'ecole, sans historique
/// de decision de conseil de classe). Distinct de la reinscription
/// (StudentTermReport + confirmReinscription) : ici le niveau cible est
/// choisi directement par le personnel qui saisit l'admission. Tant que
/// confirmedAt est null, l'eleve est "en attente de paiement" et n'a aucun
/// Enrollment. Une fois le seuil de paiement atteint, EnrollmentsService cree
/// l'Enrollment (classId: null, pool en attente d'affectation) et renseigne
/// confirmedAt/confirmedByUserId/confirmationSource ici.
model StudentAdmission {
  id                 String                        @id @default(cuid())
  schoolId           String
  studentId          String
  schoolYearId       String
  academicLevelId    String
  trackId            String?
  createdByUserId    String
  createdAt          DateTime                      @default(now())
  confirmedAt        DateTime?
  confirmedByUserId  String?
  confirmationSource EnrollmentConfirmationSource?
  school             School                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student            Student                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear         SchoolYear                    @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  academicLevel      AcademicLevel                 @relation("StudentAdmissionAcademicLevel", fields: [academicLevelId], references: [id], onDelete: Restrict)
  track              Track?                        @relation("StudentAdmissionTrack", fields: [trackId], references: [id], onDelete: SetNull)
  createdByUser      User                          @relation("StudentAdmissionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  confirmedByUser    User?                         @relation("StudentAdmissionConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@unique([schoolYearId, studentId])
  @@index([schoolId])
  @@index([schoolYearId])
  @@index([studentId])
  @@index([academicLevelId])
  @@index([trackId])
  @@index([createdByUserId])
  @@index([confirmedByUserId])
}
