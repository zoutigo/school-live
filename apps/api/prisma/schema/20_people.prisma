model Student {
  id          String          @id @default(cuid())
  schoolId    String
  userId      String?
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  parentLinks ParentStudent[] @relation("StudentLinks")
  studentGrades StudentGrade[]
  evaluationScores StudentEvaluationScore[]
  termReports   StudentTermReport[]
  homeworkCompletions HomeworkCompletion[]
  homeworkComments HomeworkComment[]
  enrollments Enrollment[]
  lifeEvents  StudentLifeEvent[]
  healthConditions  StudentHealthCondition[]
  healthCareEvents  StudentHealthCareEvent[]
  healthReports     StudentHealthReport[]
  healthAccessLogs  StudentHealthAccessLog[]
  payments          StudentPayment[]
  walletAllocations WalletTransaction[]

  @@index([schoolId])
  @@unique([schoolId, userId])
}

model Enrollment {
  id                  String           @id @default(cuid())
  schoolId            String
  schoolYearId        String
  studentId           String
  classId             String?
  academicLevelId     String?
  trackId             String?
  status              EnrollmentStatus @default(ACTIVE)
  confirmedAt         DateTime?
  confirmedByUserId   String?
  confirmationSource  EnrollmentConfirmationSource?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  school              School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear          SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class               Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  academicLevel       AcademicLevel?   @relation("EnrollmentAcademicLevel", fields: [academicLevelId], references: [id], onDelete: SetNull)
  track               Track?           @relation("EnrollmentTrack", fields: [trackId], references: [id], onDelete: SetNull)
  confirmedByUser      User?           @relation("EnrollmentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@unique([schoolYearId, studentId])
  @@index([schoolId])
  @@index([schoolYearId])
  @@index([classId])
  @@index([studentId])
  @@index([academicLevelId])
  @@index([trackId])
  @@index([confirmedByUserId])
}

model ParentStudent {
  id           String   @id @default(cuid())
  schoolId     String
  parentUserId String
  studentId    String
  createdAt    DateTime @default(now())
  parent       User     @relation("ParentLinks", fields: [parentUserId], references: [id], onDelete: Cascade)
  student      Student  @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

model Teacher {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@unique([schoolId, userId])
}

model UserRecoveryAnswer {
  id          String              @id @default(cuid())
  userId      String
  questionKey RecoveryQuestionKey
  answerHash  String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionKey])
  @@index([userId])
}
