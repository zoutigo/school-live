// Réglages plateforme génériques (clé/valeur JSON) : infos de contact,
// liens réseaux sociaux, etc. Le fallback si une clé est absente vit
// côté service NestJS, jamais dans le frontend.
model SiteSetting {
  key         String   @id
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SiteSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

// Contenus légaux versionnés (CGU, mentions légales, confidentialité...).
// Seule la version PUBLISHED la plus récente pour (slug, locale) est
// exposée publiquement ; le fallback si aucune version publiée n'existe
// vit côté service NestJS.
model LegalDocument {
  id          String                @id @default(cuid())
  slug        String
  locale      String
  version     Int
  title       String
  contentHtml String
  status      HelpPublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdById String
  createdBy   User                  @relation("LegalDocumentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String
  updatedBy   User                  @relation("LegalDocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([slug, locale, version])
  @@index([slug, locale, status])
}
