enum QuizQuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  TRUE_FALSE
}

// Étape d'apprentissage du chapitre, pas une difficulté de question :
// Découverte = reconnaissance passive, Pratique = incite à faire le geste
// réel dans l'appli (deepLinkRoute) avant de pouvoir réessayer en cas
// d'erreur, Maîtrise = question autonome avec indice et révélation de la
// bonne réponse en cas d'échec.
enum QuizStage {
  DISCOVERY
  PRACTICE
  MASTERY
}

// Quiz de formation ludique : un chapitre = un module applicatif, pour un
// rôle donné. Les questions/réponses sont identiques pour tous les users
// d'un même rôle et maintenues manuellement (seeds), pas via back-office.
model QuizChapter {
  id          String  @id @default(cuid())
  moduleKey   String
  role        AppRole
  order       Int
  isActive    Boolean @default(true)
  needsReview Boolean @default(false)

  icon      String
  colorFrom String
  colorTo   String

  titleFr       String
  titleEn       String
  descriptionFr String
  descriptionEn String

  questions QuizQuestion[]
  levels    QuizChapterLevel[]

  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  quizUserLevelIntroSeens QuizUserLevelIntroSeen[]

  @@unique([role, moduleKey])
  @@index([role, isActive])
}

// Contenu éditorial de la page d'introduction affichée avant de démarrer un
// niveau (objectif pédagogique). Saisi manuellement (comme le reste du
// contenu training-quiz), une ligne par (chapitre, stage) ; absente tant que
// personne n'a rédigé de texte personnalisé pour ce couple — le service
// retombe alors sur un texte générique basé sur la description du chapitre.
model QuizChapterLevel {
  id        String      @id @default(cuid())
  chapterId String
  chapter   QuizChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  stage     QuizStage

  objectiveFr String?
  objectiveEn String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, stage])
}

// Un utilisateur ne revoit plus la page d'intro d'un niveau une fois qu'il
// l'a validée — persisté côté serveur pour survivre à une reconnexion.
model QuizUserLevelIntroSeen {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   QuizChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  stage     QuizStage
  seenAt    DateTime    @default(now())

  @@unique([userId, chapterId, stage])
}

model QuizQuestion {
  id        String           @id @default(cuid())
  chapterId String
  chapter   QuizChapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order     Int
  type      QuizQuestionType @default(MCQ_SINGLE)
  stage     QuizStage        @default(DISCOVERY)
  isActive  Boolean          @default(true)

  textFr        String
  textEn        String
  // Indice actionnable ("cliquez sur...", "ouvrez...") consultable avant de
  // répondre, distinct de l'explication affichée après la réponse.
  hintFr        String
  hintEn        String
  explanationFr String
  explanationEn String

  imageUrl      String?
  deepLinkRoute String?

  options  QuizAnswerOption[]
  progress QuizUserQuestionProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, order])
}

model QuizAnswerOption {
  id         String       @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int
  isCorrect  Boolean

  textFr String
  textEn String

  @@unique([questionId, order])
}

// Progression par utilisateur/question. Pas de note éliminatoire : on
// retente à volonté, `solved` passe à true dès la première bonne réponse
// et le reste pour toujours.
model QuizUserQuestionProgress {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptsCount  Int       @default(0)
  solved         Boolean   @default(false)
  solvedAt       DateTime?
  lastAnsweredAt DateTime?

  @@unique([userId, questionId])
  @@index([userId, solved])
}
